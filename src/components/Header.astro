---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { t, localePath } from '../i18n/utils';
import { site, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const home = localePath(locale);
const links = [
  { href: `${home}#sesiones`, label: d.nav.sessions },
  { href: `${home}#que-es`, label: d.nav.whatIs },
  { href: `${home}#manifiesto`, label: d.nav.manifesto },
  { href: `${home}#partners`, label: d.nav.partners },
  { href: `${home}#preguntas`, label: d.nav.faq },
];
---

<header
  id="site-header"
  data-close-label={d.nav.close}
  class="hairline sticky top-0 z-50 border-b bg-grafito/85 backdrop-blur supports-[backdrop-filter]:bg-grafito/70"
>
  <div class="section flex h-16 items-center justify-between gap-6">
    <a href={home} class="shrink-0 text-[1.1rem]" aria-label={site.name}>
      <Logo />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
      {
        links.map((l) => (
          <a href={l.href} class="label text-ceniza transition-colors hover:text-hueso">
            {l.label}
          </a>
        ))
      }
      <a
        href={site.luma}
        class="label text-ceniza transition-colors hover:text-hueso"
        target="_blank"
        rel="noopener">{d.nav.luma}</a
      >
      <span class="h-4 w-px bg-hueso/20" aria-hidden="true"></span>
      <LangSwitch locale={locale} />
      <a href={site.luma} class="btn btn-primary" target="_blank" rel="noopener">{d.nav.cta}</a>
    </nav>

    <div class="flex items-center gap-4 md:hidden">
      <LangSwitch locale={locale} />
      <button
        type="button"
        class="label flex items-center gap-2 text-hueso"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span data-menu-label>{d.nav.menu}</span>
        <span aria-hidden="true" class="text-brasa">+</span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hairline hidden border-t bg-grafito md:hidden" data-mobile-nav>
    <nav class="section flex flex-col py-4" aria-label="Principal (móvil)">
      {
        links.map((l) => (
          <a href={l.href} class="hairline label border-b py-4 text-hueso" data-menu-link>
            {l.label}
          </a>
        ))
      }
      <a
        href={site.luma}
        class="hairline label border-b py-4 text-hueso"
        target="_blank"
        rel="noopener">{d.nav.luma}</a
      >
      <a href={site.luma} class="btn btn-primary mt-5 self-start" target="_blank" rel="noopener"
        >{d.nav.cta}</a
      >
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = header?.querySelector<HTMLElement>('[data-mobile-nav]');
  const labelEl = header?.querySelector<HTMLElement>('[data-menu-label]');
  if (toggle && panel && labelEl) {
    const openLabel = labelEl.textContent ?? '';
    const closeLabel = header?.dataset.closeLabel ?? openLabel;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
      labelEl.textContent = open ? closeLabel : openLabel;
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => set(false)));
  }
</script>
