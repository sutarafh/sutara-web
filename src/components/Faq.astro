---
import SectionHeading from './SectionHeading.astro';
import { t } from '../i18n/utils';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section id="preguntas" class="hairline scroll-mt-16 border-t">
  <div class="section grid gap-12 py-20 md:grid-cols-[1fr_1.6fr] md:py-24">
    <SectionHeading kicker={d.faq.kicker} title={d.faq.title} size="md" />
    <div class="hairline divide-y divide-hueso/15 border-t">
      {
        d.faq.items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 font-display text-xl font-semibold tracking-[-0.03em] text-hueso [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <span class="font-mono text-brasa transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 max-w-xl text-ceniza">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
