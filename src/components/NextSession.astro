---
import SectionHeading from './SectionHeading.astro';
import { t, pick, formatDate } from '../i18n/utils';
import type { Locale } from '../data/site';
import { nextSession } from '../data/sessions';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const s = nextSession;
---

{
  s && (
    <section id="sesiones" class="hairline scroll-mt-16 border-t">
      <div class="section grid gap-12 py-20 md:grid-cols-2 md:py-24">
        <div>
          <SectionHeading
            kicker={`${d.nextSession.kicker} · ${pick(s.name, locale)}`}
            title={d.nextSession.title}
            size="md"
          />
          <dl class="ticks mt-10 divide-y divide-hueso/15">
            {[
              [d.nextSession.when, `${formatDate(s.date, locale, 'weekday')} · ${s.time}`],
              [d.nextSession.where, `${s.city}. ${pick(s.venue, locale)}`],
              [d.nextSession.spots, `${s.spots} ${d.nextSession.people}`],
              [d.nextSession.price, d.nextSession.free],
            ].map(([k, v]) => (
              <div class="grid grid-cols-[6rem_1fr] gap-4 px-4 py-4">
                <dt class="label pt-1 text-piedra">{k}</dt>
                <dd class="text-hueso">{v}</dd>
              </div>
            ))}
          </dl>
          <a href={s.luma} class="btn btn-solid mt-8" target="_blank" rel="noopener">
            {d.nextSession.cta}
          </a>
          <p class="mt-6 max-w-md text-sm text-piedra">{d.nextSession.allSessions}</p>
        </div>

        <div>
          <p class="label text-brasa">{d.nextSession.program}</p>
          <ol class="hairline mt-6 divide-y divide-hueso/15 border-t">
            {s.program.map((p) => (
              <li class="grid gap-2 py-5 sm:grid-cols-[1fr_auto] sm:gap-6">
                <div>
                  <p class="font-display text-xl font-semibold tracking-[-0.03em] text-hueso">
                    <span class="mr-2 text-brasa" aria-hidden="true">
                      →
                    </span>
                    {pick(p.title, locale)}
                  </p>
                  <p class="mt-1.5 text-sm text-ceniza">{pick(p.detail, locale)}</p>
                  {p.kind === 'talk' && (
                    <p class="label mt-2 text-piedra">{p.speaker ?? d.nextSession.speakerTba}</p>
                  )}
                </div>
                {p.duration && <span class="label pt-1 text-piedra">{p.duration}</span>}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}
