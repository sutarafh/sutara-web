---
import SectionHeading from './SectionHeading.astro';
import { t, localePath } from '../i18n/utils';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section id="que-es" class="hairline scroll-mt-16 border-t">
  <div class="section py-20 md:py-24">
    <SectionHeading kicker={d.whatIs.kicker} title={d.whatIs.title} />
    <p class="mt-8 max-w-2xl text-pretty text-lg text-ceniza">{d.whatIs.lead}</p>

    <div class="hairline mt-16 grid divide-y divide-hueso/15 border-t md:grid-cols-3 md:divide-x md:divide-y-0">
      {
        d.whatIs.cards.map((c) => (
          <div class="py-8 md:px-8 md:first:pl-0 md:last:pr-0">
            <h3 class="text-2xl text-hueso">
              <span class="mr-2 text-brasa" aria-hidden="true">
                →
              </span>
              {c.title}
            </h3>
            <p class="mt-4 text-sm text-ceniza">{c.body}</p>
          </div>
        ))
      }
    </div>

    <p class="label mt-10 text-piedra">
      <a href={`${localePath(locale)}#manifiesto`} class="text-hueso hover:text-brasa">{d.whatIs.manifestoLink} →</a>
    </p>
  </div>
</section>
