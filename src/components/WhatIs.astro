---
import SectionHeading from './SectionHeading.astro';
import { t, localePath } from '../i18n/utils';
import { site, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section id="que-es" class="hairline scroll-mt-16 border-t">
  <div class="section py-20 md:py-24">
    <SectionHeading kicker={d.whatIs.kicker} title={d.whatIs.title} />
    <div class="mt-10 grid gap-12 md:grid-cols-[1.2fr_1fr] md:gap-16">
      <p class="max-w-xl text-pretty text-lg text-ceniza">{d.whatIs.lead}</p>
      <dl class="ticks grid grid-cols-3 divide-x divide-hueso/15">
        {
          d.whatIs.stats.map((s) => (
            <div class="px-4 py-5">
              <dd class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-semibold tracking-[-0.05em] text-hueso">
                {s.value}
              </dd>
              <dt class="mt-2 text-[0.6875rem] uppercase tracking-[0.12em] text-piedra">{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hairline mt-16 grid divide-y divide-hueso/15 border-t md:grid-cols-3 md:divide-x md:divide-y-0">
      {
        d.whatIs.cards.map((c) => (
          <div class="py-8 md:px-8 md:first:pl-0 md:last:pr-0">
            <h3 class="text-2xl text-hueso">
              <span class="mr-2 text-brasa" aria-hidden="true">
                →
              </span>
              {c.title}
            </h3>
            <p class="mt-4 text-sm text-ceniza">{c.body}</p>
          </div>
        ))
      }
    </div>

    <p class="label mt-10 text-piedra">
      <a href={`${localePath(locale)}#manifiesto`} class="text-hueso hover:text-brasa">{d.whatIs.manifestoLink} →</a>
      <span class="mx-3 text-brasa">*</span>
      <a href={site.community.url} target="_blank" rel="noopener" class="hover:text-hueso">{site.community.name}</a>
    </p>
  </div>
</section>
