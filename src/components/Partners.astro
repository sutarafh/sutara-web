---
/** Partners: solo un call to action corto que lleva al correo. */
import SectionHeading from './SectionHeading.astro';
import { t } from '../i18n/utils';
import { site, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const subject = encodeURIComponent(d.partners.mailSubject);
---

<section id="partners" class="hairline scroll-mt-16 border-t">
  <div class="section grid gap-10 py-20 md:grid-cols-[1.4fr_1fr] md:items-end md:py-24">
    <div>
      <SectionHeading kicker={d.partners.kicker} title={d.partners.title} />
      <p class="mt-8 max-w-2xl text-pretty text-lg text-ceniza">{d.partners.lead}</p>
    </div>
    <div class="ticks px-6 py-6 md:justify-self-end">
      <p class="text-ceniza">{d.partners.body}</p>
      <a href={`mailto:${site.email}?subject=${subject}`} class="btn btn-primary mt-6">{d.partners.cta}</a>
      <p class="label mt-4 text-piedra">{site.email}</p>
    </div>
  </div>
</section>
