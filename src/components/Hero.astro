---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/brand/foto-umbral.webp';
import SessionCard from './SessionCard.astro';
import { t } from '../i18n/utils';
import { site, type Locale } from '../data/site';
import { nextSession } from '../data/sessions';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="relative isolate overflow-hidden">
  <!-- Foto de forja oscurecida + textura de pizarra encima (regla: grafito siempre con pizarra) -->
  <div class="absolute inset-0 -z-10">
    <Image
      src={heroPhoto}
      alt=""
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[70%_50%] opacity-60"
    />
    <div class="bg-pizarra absolute inset-0 opacity-60 mix-blend-multiply"></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(21,21,21,0.95)_0%,rgba(21,21,21,0.75)_45%,rgba(21,21,21,0.35)_100%)]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-grafito"></div>
  </div>

  <div class="section grid items-center gap-14 py-20 md:grid-cols-[1.25fr_1fr] md:py-28 lg:gap-20">
    <div>
      <p class="label flex items-center gap-2 text-brasa">
        <span aria-hidden="true">→</span>
        {d.hero.kicker}
      </p>
      <h1 class="mt-6 text-[clamp(2.75rem,7.2vw,5.75rem)] text-hueso">{d.hero.title}</h1>
      <p class="mt-8 max-w-xl text-pretty text-ceniza">{d.hero.lead}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={site.luma} class="btn btn-primary" target="_blank" rel="noopener">{d.hero.ctaPrimary}</a>
        <a href="#que-es" class="btn btn-ghost">{d.hero.ctaSecondary}</a>
      </div>
      <p class="label mt-8 text-piedra">{d.hero.guestList}</p>
    </div>

    {
      nextSession && (
        <div class="flex justify-center md:justify-end">
          <SessionCard session={nextSession} locale={locale} />
        </div>
      )
    }
  </div>
</section>
